# @n8n/node-cli@0.30+ declares peer eslint >= 9, but this project pins eslint ^8.57
# to avoid migrating to ESLint 9's flat config. This setting matches the local
# `npm install` default behavior (which warns but installs) so CI `npm ci` doesn't
# fail strict peer-dep resolution. Revisit when we migrate to ESLint 9.
legacy-peer-deps=true
